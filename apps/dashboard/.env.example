# URL of the Express API server — must be reachable from the user's browser
# Change this when deploying the dashboard on a separate server from the API
NEXT_PUBLIC_API_URL=http://localhost:3001

# Email of the operator account — shows the Admin nav link and section for this
# user only. Not a secret (real enforcement happens server-side via ADMIN_EMAIL
# on the API); just controls UI visibility. Must match the API's ADMIN_EMAIL.
NEXT_PUBLIC_ADMIN_EMAIL=

# Product analytics (PostHog, optional). Without a key, analytics.ts no-ops
# and nothing is sent. Get your project key at https://app.posthog.com/project/settings
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
